# Environment
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.DS_Store

# Data: never commit raw/processed data (reproducible via `python -m src.cli download`)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained models and run outputs are regenerated by the pipeline
models/*
!models/.gitkeep
reports/runs/*/scores/

# Offline demo on SIMULATED data (`python -m src.cli demo`): always regenerated, never committed
data/demo/
reports/runs/demo/

# Local reproductions (configs/reproduce*.yaml, *_smoke.yaml): generated, never committed
reports/runs/reproduce*/
reports/runs/telemanom_smoke/

# Notebook outputs (notebooks/run_pipeline.ipynb)
outputs/
configs/telemanom_nb_*.yaml
reports/runs/telemanom_nb_*/

# Saved weights are never committed (pre-commit hook); the showcase builder writes them locally
reports/showcase/models/
