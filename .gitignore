# Environment
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.DS_Store

# Data: never commit raw/processed data (reproducible via `python -m src.cli download`)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained models and run outputs are regenerated by the pipeline
models/*
!models/.gitkeep
reports/runs/*/scores/
